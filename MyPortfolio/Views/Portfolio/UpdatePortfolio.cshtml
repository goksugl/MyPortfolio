@model Portfolio

@{
    ViewData["Title"] = "UpdatePortfolio";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Portfolyo (Projelerim)</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Proje Güncelleme Sayfası</div>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            
                            <input type="hidden" asp-for="PortfolioId" /> 

                            <label>Proje Başlığı</label>
                            <input type="text" asp-for="Title" class="form-control" />
                            <br />

                            <label>Alt Başlık / Teknoloji</label>
                            <input type="text" asp-for="SubTitle" class="form-control" />
                            <br />

                            <label>Proje Görseli (Görsel Linki)</label>
                            <input type="text" asp-for="ImageUrl" class="form-control" />
                            <br />

                            <label>Proje Linki (GitHub veya Site URL)</label>
                            <input type="text" asp-for="Url" class="form-control" />
                            <br />

                            <label>Proje Detayları / Açıklama</label>
                            <textarea rows="5" asp-for="Description" class="form-control"></textarea>
                            <br />

                            <button class="btn btn-success">Değişiklikleri Kaydet</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

