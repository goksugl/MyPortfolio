@model List<MyPortfolio.DAL.Entities.Reference>
@{
    ViewData["Title"] = "ReferenceList";
    Layout = "~/Views/Layout/Index.cshtml";
    int count = 0;
}

<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Referanslarım</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Referans Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Sizinle çalışan kişilerin yorumlarını buradan yönetebilirsiniz.
                        </div>
                        <table class="table mt-3">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Ad Soyad</th>
                                    <th scope="col">Ünvan / Şirket</th>
                                    <th scope="col">Yorum</th>
                                    <th scope="col">Görsel</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td>@count</td>
                                        <td>@item.NameSurname</td>
                                        <td>@item.Title</td>
                                        
                                        <td>
                                            @if (item.Comment != null && item.Comment.Length > 40)
                                            {
                                                @item.Comment.Substring(0, 40) <text>...</text>
                                            }
                                            else
                                            {
                                                @item.Comment
                                            }
                                        </td>

                                        <td>
                                            <img src="@item.ImageUrl" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover;" />
                                        </td>
                                        <td><a href="/Reference/DeleteReference/@item.ReferenceId" class="btn btn-danger">Sil</a></td>
                                        <td><a href="/Reference/UpdateReference/@item.ReferenceId" class="btn btn-success">Güncelle</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <a href="/Reference/CreateReference/" class="btn btn-primary">Yeni Referans Ekle</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
